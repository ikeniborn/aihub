# HuggingFace Hub token — required for gated models (Llama, etc.)
# Create token at: https://huggingface.co/settings/tokens
# Accept model licenses at: https://huggingface.co/{repo_id}
HF_TOKEN=hf_YOUR_TOKEN_HERE

# Enable fast Rust-based downloads (requires hf_transfer package)
# Set to 1 to activate; leave empty or 0 to use standard downloads
HF_HUB_ENABLE_HF_TRANSFER=1

# CivitAI API key — only needed for image models hosted on CivitAI
# Create key at: https://civitai.com/user/account
CIVITAI_API_KEY=

# Override default models directory (default: ./models)
# MODELS_DIR=./models

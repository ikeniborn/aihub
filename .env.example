# ─────────────────────────────────────────────────────────────────────────────
# AI Hub — переменные окружения
# Скопируйте этот файл в .env и заполните нужные значения:
#   cp .env.example .env
#
# Секреты (HF-токен, S3 ключи) хранятся ТОЛЬКО в credentials.yaml,
# не в .env — чтобы не попасть в git.
# ─────────────────────────────────────────────────────────────────────────────


# ── browse_models.py — фильтры поиска HuggingFace ────────────────────────────
# Все переменные ниже задают дефолты; CLI-аргументы всегда имеют приоритет.

# Задача модели (pipeline_tag) — что умеет делать модель.
# Значения: text-generation | text-to-image | automatic-speech-recognition |
#           text-classification | sentence-similarity | image-classification |
#           text-to-speech | translation | summarization | zero-shot-classification
# BROWSE_PIPELINE_TAG=text-generation

# Формат / библиотека — в каком виде хранится модель.
# Значения: gguf | safetensors | transformers | diffusers | onnx |
#           sentence-transformers | mlx | openvino
# BROWSE_LIBRARY=gguf

# Язык модели (ISO 639-1).
# Значения: ru | en | zh | de | fr | ja | ko | ...
# BROWSE_LANGUAGE=

# Regex-фильтр по именам файлов внутри репозитория.
# Примеры:
#   Q4_K_M\.gguf$          — только Q4_K_M квантизация
#   Q[458]_K_[MS]\.gguf$   — Q4/Q5/Q8 K_M или K_S
#   \.safetensors$          — только safetensors
BROWSE_FILE_REGEX=Q4_K_M\.gguf$


# ── Proxy ─────────────────────────────────────────────────────────────────────

# Включить HTTP-прокси для всех запросов (HuggingFace, S3).
# PROXY_ENABLED=false
# PROXY_URL=http://proxy.example.com:8080
# PROXY_URL=http://user:password@proxy.example.com:3128


# ── S3 / Object Storage ───────────────────────────────────────────────────────

# Бакет и параметры подключения. Ключи хранятся в credentials.yaml (s3.*).
# S3_BUCKET=my-models-bucket
# S3_REGION=us-east-1
# S3_PREFIX=models

# Кастомный endpoint для MinIO, Yandex Object Storage, Cloudflare R2 и т.п.
# S3_ENDPOINT_URL=https://storage.yandexcloud.net
# S3_ENDPOINT_URL=http://localhost:9000


# ── Fast downloads ────────────────────────────────────────────────────────────

# Включить hf_transfer (Rust-based, требует: pip install hf_transfer).
# HF_HUB_ENABLE_HF_TRANSFER=1

# ── Контроль нагрузки на канал ────────────────────────────────────────────────
# ВНИМАНИЕ: параметры ниже задаются в models.yaml (секция settings:), а НЕ здесь.
# hf_download_concurrency: 4    # макс. параллельных TCP Xet (null = без лимита)
# download_timeout_hours: 2     # таймаут на файл в часах (0 = без лимита)
# bandwidth_limit_mbps: null    # лимит Mbit/s для HTTP (не влияет на Xet)
# Подробнее: docs/ENV.md → "Контроль нагрузки на канал"

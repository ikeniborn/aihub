# AI Model Downloader — Настроечные параметры
# =============================================
# Секреты (токены, ключи) хранятся в credentials.yaml — НЕ здесь.

# ── HuggingFace ───────────────────────────────────────────────────────────────
# Ускоренные загрузки на Rust (требует пакет hf_transfer из requirements.txt)
HF_HUB_ENABLE_HF_TRANSFER=1

# ── Директория хранения моделей ───────────────────────────────────────────────
# По умолчанию: ./models (задаётся также в models.yaml → settings.models_dir)
# MODELS_DIR=./models

# ── S3 / объектное хранилище: параметры подключения ──────────────────────────
# Ключи доступа (access_key_id, secret_access_key) — в credentials.yaml

# Регион (AWS: us-east-1, eu-west-1; для MinIO/Yandex оставить us-east-1)
S3_REGION=us-east-1

# Имя бакета (должен существовать)
S3_BUCKET=

# Префикс ключей внутри бакета (итоговый ключ: {prefix}/{dest_dir}/{filename})
S3_PREFIX=models

# Endpoint для не-AWS провайдеров (оставить пустым для стандартного AWS S3):
#   MinIO локально:     http://localhost:9000
#   MinIO remote:       https://minio.example.com
#   Yandex OBS:         https://storage.yandexcloud.net
#   Cloudflare R2:      https://<ACCOUNT_ID>.r2.cloudflarestorage.com
#   Backblaze B2:       https://s3.<REGION>.backblazeb2.com
S3_ENDPOINT_URL=

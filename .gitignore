# Sphinx intermediate build files (html/ is committed)
docs/sphinx/_build/.doctrees/

# Claude Code Agent Workspace
.claude/workspace/
.claude/sessions/

# AI Models — large binary files, never commit
models/
*.gguf
*.safetensors
*.ckpt
*.pt
*.bin

# ETag sidecar files (download state tracking)
**/*.etag

# HuggingFace Hub local cache
.cache/huggingface/

# Credentials and secrets — NEVER commit these files
.env
.env.local
.env.*.local
credentials.yaml
credentials.*.yaml

# Process lock file (download_models.py runtime artifact)
.download.lock

# Python
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
dist/
build/
.venv/
venv/

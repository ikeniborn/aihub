# AI Model Downloader — Файл секретов
# =====================================
# Скопируйте в credentials.yaml и заполните реальными значениями.
# credentials.yaml НИКОГДА не коммитится в git.
#
# Здесь хранятся ТОЛЬКО секреты (токены и ключи).
# Настроечные параметры (bucket, region, prefix) — в .env
#
# Использование:
#   cp credentials.yaml.example credentials.yaml

huggingface:
  # Токен для закрытых моделей (Meta Llama, Google Gemma и др.)
  # 1. Создать: https://huggingface.co/settings/tokens
  # 2. Принять лицензию: https://huggingface.co/<repo_id>
  token: ""

s3:
  # Секретные ключи доступа к S3 / совместимому хранилищу
  # Работает с: AWS S3, MinIO, Yandex Object Storage, Cloudflare R2, Backblaze B2
  access_key_id: ""
  secret_access_key: ""

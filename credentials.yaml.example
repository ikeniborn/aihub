# =============================================================================
# aihub — шаблон credentials.yaml
# Скопируйте: cp credentials.yaml.example credentials.yaml  и заполните значения.
# Этот файл добавлен в .gitignore — никогда не коммитьте с реальными секретами.
# =============================================================================


# ── HuggingFace ───────────────────────────────────────────────────────────────
# Токен для доступа к закрытым (gated) моделям: Llama, Gemma, Mistral и др.
# Получить: https://huggingface.co/settings/tokens
# Оставьте пустым если используете только публичные модели.
huggingface:
  token: ""           # hf_...


# ── S3 / Object Storage ───────────────────────────────────────────────────────
# Ключи доступа для синхронизации моделей в S3-совместимое хранилище.
# Параметры подключения (bucket, region, endpoint) — в .env, не здесь.
s3:
  access_key_id: ""
  secret_access_key: ""


# ── Proxy (опционально) ───────────────────────────────────────────────────────
# Альтернатива переменным PROXY_ENABLED / PROXY_URL в .env.
# .env имеет приоритет над этим разделом.
# Форматы url: http://host:port  |  http://user:password@host:port
proxy:
  enabled: false
  url: ""
